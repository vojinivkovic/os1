  49:src/Kernel.cpp **** void* Kernel::mallocSystemStack(size_t numOfBytes)
  50:src/Kernel.cpp **** {
  51:src/Kernel.cpp ****     size_t numOfBlocks = numOfBytes / MEM_BLOCK_SIZE;
  52:src/Kernel.cpp ****     numOfBlocks += numOfBytes % MEM_BLOCK_SIZE ? 1 : 0;
  53:src/Kernel.cpp ****     uint8* systemStack = (uint8*)MemoryAllocator::allocateMemory(numOfBlocks);
  54:src/Kernel.cpp ****     return (void*)(&systemStack[KernelConfig::DEFAULT_SYSTEM_STACK_SIZE]);
  55:src/Kernel.cpp **** }
  56:src/Kernel.cpp **** void Kernel::interruptHandler()
  57:src/Kernel.cpp **** {
  58:src/Kernel.cpp ****     volatile uint64 basePointer;
  59:src/Kernel.cpp ****     __asm__ volatile ("addi %[reg], s0, 0x0": [reg]"=r"(basePointer)); // Problem: da li mozemo bit
  60:src/Kernel.cpp ****     uint64 scause = Machine::readScause();
  61:src/Kernel.cpp ****     if(scause == 0x0000000000000008UL || scause == 0x0000000000000009UL)
  62:src/Kernel.cpp ****     {
  63:src/Kernel.cpp ****         // scause == 0x0000000000000008UL; software interrupt(ecall) from user mode
  64:src/Kernel.cpp ****         // scause == 0x0000000000000009UL; sotware interrupt(ecall) from kernel(supervised) mode
  65:src/Kernel.cpp **** 
  66:src/Kernel.cpp ****         Machine::bc_sip(Machine::SSIP);
  67:src/Kernel.cpp **** 
  68:src/Kernel.cpp ****         uint64 sepc = Machine::readSepc() + 4;
  69:src/Kernel.cpp ****         uint64 sstatus = Machine::readSstatus();
  70:src/Kernel.cpp **** 
  71:src/Kernel.cpp ****         uint64 numberOfEntry;
  72:src/Kernel.cpp ****         __asm__ volatile ("ld %[rd], 80(%[rs])": [rd]"=r"(numberOfEntry):[rs]"r"(basePointer));
  73:src/Kernel.cpp **** 
  74:src/Kernel.cpp ****         ArgumentsOfSystemCall arg;
  75:src/Kernel.cpp ****         initializeArguments(&arg, basePointer);
  76:src/Kernel.cpp ****         systemCallsTable[numberOfEntry](&arg);
  77:src/Kernel.cpp ****         __asm__ volatile("sd a0, 80(%[rs])"::[rs]"r"(basePointer));
  78:src/Kernel.cpp **** 
  79:src/Kernel.cpp ****         TCB::dispatch();
  80:src/Kernel.cpp **** 
  81:src/Kernel.cpp ****         Machine::writeSepc(sepc);
  82:src/Kernel.cpp ****         Machine::writeSstatus(sstatus);
  83:src/Kernel.cpp ****     }
  84:src/Kernel.cpp ****     else if (scause == 0x8000000000000001UL)
  85:src/Kernel.cpp ****     {
  86:src/Kernel.cpp ****         Machine::bc_sip(Machine::SSIP);
  87:src/Kernel.cpp ****         TCB::incrementNumOfTicks();
  88:src/Kernel.cpp ****         //TCB::numOfTicks++;
  89:src/Kernel.cpp ****         if(TCB::getNumOfTicks() >= TCB::getRunningThread()->getTimeSlice())
  90:src/Kernel.cpp ****         {
  91:src/Kernel.cpp ****             //TCB::numOfTicks = 0;
  92:src/Kernel.cpp ****             TCB::resetNumOfTicks();
  93:src/Kernel.cpp ****             uint64 sepc = Machine::readSepc() + 4;
  94:src/Kernel.cpp ****             uint64 sstatus = Machine::readSstatus();
  95:src/Kernel.cpp **** 
  96:src/Kernel.cpp ****             TCB::dispatch();
  97:src/Kernel.cpp **** 
  98:src/Kernel.cpp ****             Machine::writeSepc(sepc);
  99:src/Kernel.cpp ****             Machine::writeSstatus(sstatus);
 100:src/Kernel.cpp ****         }
 101:src/Kernel.cpp ****     }
 102:src/Kernel.cpp **** 
 103:src/Kernel.cpp **** }
