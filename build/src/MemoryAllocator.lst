  43:src/MemoryAllocator.cpp **** void* MemoryAllocator::findBestFit(FreeBlock **head, size_t blocksToAllocate)
  44:src/MemoryAllocator.cpp **** {
  45:src/MemoryAllocator.cpp ****     FreeBlock* bestBlock = nullptr;
  46:src/MemoryAllocator.cpp **** 
  47:src/MemoryAllocator.cpp ****     for(FreeBlock* curr = (*head); curr; curr = curr->nextBlock)
  48:src/MemoryAllocator.cpp ****     {
  49:src/MemoryAllocator.cpp ****         if(curr->numOfBlocks >= blocksToAllocate)
  50:src/MemoryAllocator.cpp ****         {   if(bestBlock == nullptr)
  51:src/MemoryAllocator.cpp ****             {
  52:src/MemoryAllocator.cpp ****                 bestBlock = curr;
  53:src/MemoryAllocator.cpp ****                 continue;
  54:src/MemoryAllocator.cpp ****             }
  55:src/MemoryAllocator.cpp ****             if(bestBlock->numOfBlocks > curr->numOfBlocks)
  56:src/MemoryAllocator.cpp ****             {
  57:src/MemoryAllocator.cpp ****                 bestBlock = curr;
  58:src/MemoryAllocator.cpp ****             }
  59:src/MemoryAllocator.cpp ****         }
  60:src/MemoryAllocator.cpp ****     }
  61:src/MemoryAllocator.cpp **** 
  62:src/MemoryAllocator.cpp ****     numOfFreeBlocks -= blocksToAllocate;
  63:src/MemoryAllocator.cpp ****     bestBlock->numOfBlocks -= blocksToAllocate;
  64:src/MemoryAllocator.cpp ****     remapMemory(head, bestBlock, blocksToAllocate);
  65:src/MemoryAllocator.cpp **** 
  66:src/MemoryAllocator.cpp ****     //bestBlock->nextBlock = nullptr;
  67:src/MemoryAllocator.cpp ****     //bestBlock->previousBlock = nullptr;
  68:src/MemoryAllocator.cpp **** 
  69:src/MemoryAllocator.cpp ****     OccupiedBlock* occupiedBlock = (OccupiedBlock*)bestBlock;
  70:src/MemoryAllocator.cpp ****     occupiedBlock->flagFree = false;
  71:src/MemoryAllocator.cpp ****     occupiedBlock->numOfBlocks = blocksToAllocate;
  72:src/MemoryAllocator.cpp ****     occupiedBlock++;
  73:src/MemoryAllocator.cpp ****     return occupiedBlock;
  74:src/MemoryAllocator.cpp **** }
