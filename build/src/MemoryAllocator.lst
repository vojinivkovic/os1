  43:src/MemoryAllocator.cpp **** void* MemoryAllocator::findBestFit(FreeBlock **head, size_t blocksToAllocate)
  44:src/MemoryAllocator.cpp **** {
  45:src/MemoryAllocator.cpp ****     FreeBlock* bestBlock = *head;
  46:src/MemoryAllocator.cpp **** 
  47:src/MemoryAllocator.cpp ****     for(FreeBlock* curr = (*head)->nextBlock; curr; curr = curr->nextBlock)
  48:src/MemoryAllocator.cpp ****     {
  49:src/MemoryAllocator.cpp ****         if(curr->numOfBlocks > blocksToAllocate)
  50:src/MemoryAllocator.cpp ****         {
  51:src/MemoryAllocator.cpp ****             if(bestBlock->numOfBlocks > curr->numOfBlocks)
  52:src/MemoryAllocator.cpp ****             {
  53:src/MemoryAllocator.cpp ****                 bestBlock = curr;
  54:src/MemoryAllocator.cpp ****             }
  55:src/MemoryAllocator.cpp ****         }
  56:src/MemoryAllocator.cpp ****     }
  57:src/MemoryAllocator.cpp **** 
  58:src/MemoryAllocator.cpp ****     numOfFreeBlocks -= blocksToAllocate;
  59:src/MemoryAllocator.cpp ****     bestBlock->numOfBlocks -= blocksToAllocate;
  60:src/MemoryAllocator.cpp ****     remapMemory(head, bestBlock, blocksToAllocate);
  61:src/MemoryAllocator.cpp **** 
  62:src/MemoryAllocator.cpp ****     OccupiedBlock* occupiedBlock = (OccupiedBlock*)bestBlock;
  63:src/MemoryAllocator.cpp ****     occupiedBlock->flagFree = false;
  64:src/MemoryAllocator.cpp ****     occupiedBlock->numOfBlocks = blocksToAllocate;
  65:src/MemoryAllocator.cpp ****     occupiedBlock++;
  66:src/MemoryAllocator.cpp ****     return occupiedBlock;
  67:src/MemoryAllocator.cpp **** }
